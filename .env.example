# Beispiel-Umgebungsvariablen für Spacenations Tools
# Kopiere diese Datei zu ".env" und trage echte Werte ein.
# WICHTIG: ".env" NICHT committen (steht bereits in .gitignore).
# Trage KEINE echten Secrets in diese Beispiel-Datei ein.

# --- Server (Railway) ---
# PORT wird von Railway automatisch gesetzt; lokal optional.
# PORT=8000

# --- Proxima → Discord (proxima_discord.py) ---
# Discord-Webhook-URL des Zielkanals. Ohne diese Variable ist der
# Proxima→Discord-Job deaktiviert. Erzeuge sie in Discord unter
# Kanal → Einstellungen → Integrationen → Webhooks.
DISCORD_PROXIMA_WEBHOOK=https://discord.com/api/webhooks/DEINE_WEBHOOK_ID/DEIN_WEBHOOK_TOKEN

# Optional: Intervall des Discord-Updates in Minuten (Default 10)
# PROXIMA_DISCORD_INTERVAL_MIN=10
# Optional: max. Anzahl Zeilen im Discord-Embed (Default 30)
# PROXIMA_DISCORD_MAX_ROWS=30
# Optional: abweichender Proxima-API-Endpunkt
# PROXIMA_API_URL=https://beta4.game.spacenations.eu/api/proxima

# --- Firebase-Web-Konfiguration (optional) ---
# Nur nötig, wenn die im Code hinterlegte öffentliche Web-Konfiguration
# überschrieben werden soll. Dies sind KEINE geheimen Server-Schlüssel,
# sondern die öffentliche Firebase-Web-App-Konfiguration.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
